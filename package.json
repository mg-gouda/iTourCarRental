{
  "name": "itour-car-rental",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:up": "docker compose up -d postgres redis mailhog && docker compose up backend frontend",
    "dev:down": "docker compose down",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
