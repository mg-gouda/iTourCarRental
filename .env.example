# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
POSTGRES_USER=carrental
POSTGRES_PASSWORD=changeme
POSTGRES_DB=carrental
DATABASE_URL=postgresql://carrental:changeme@postgres:5432/carrental

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ──────────────────────────────────────────────
# Backend
# ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
SESSION_SECRET=replace-with-64-char-random-string
CORS_ORIGIN=http://localhost:3000

# ──────────────────────────────────────────────
# Frontend / Auth.js
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
AUTH_SECRET=replace-with-64-char-random-string
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ──────────────────────────────────────────────
# S3-compatible storage
# ──────────────────────────────────────────────
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=carrental
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ──────────────────────────────────────────────
# Email (Mailhog in dev)
# ──────────────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@itour.local

# ──────────────────────────────────────────────
# Sentry (optional)
# ──────────────────────────────────────────────
SENTRY_DSN=

# ──────────────────────────────────────────────
# Seed
# ──────────────────────────────────────────────
SEED_ADMIN_EMAIL=mggouda@gmail.com
SEED_ADMIN_PASSWORD=Win16@64
